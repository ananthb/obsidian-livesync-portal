# SPDX-License-Identifier: AGPL-3.0-only
FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS trust
COPY LICENSE THIRD_PARTY_NOTICES.md /rootfs/app/
COPY licenses/ /rootfs/app/licenses/
RUN mkdir -p /rootfs/etc/ssl/certs /rootfs/data /rootfs/tmp && cp /rootfs/app/licenses/ca-bundle/certificates.pem /rootfs/etc/ssl/certs/ca-certificates.crt && chmod -R a+rX /rootfs/app && chmod 1777 /rootfs/tmp && chown 65532:65532 /rootfs/data

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/ananthb/obsidian-livesync-portal" org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=trust /rootfs/ /
COPY --chmod=0555 livesync-portal /app/livesync-portal
WORKDIR /
USER 65532:65532
ENV PORTAL_CONFIG=/run/secrets/portal_config
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD ["/app/livesync-portal", "healthcheck"]
ENTRYPOINT ["/app/livesync-portal"]
